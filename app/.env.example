# Copy to app/.env.local and fill in. `*.local` is git-ignored (app/.gitignore).
# Vite inlines every VITE_* variable into the bundle at build time, so only
# public values belong here. Never a secret key.

# RevenueCat public API key for the desktop's Ada Pro purchases
# (src/lib/purchases/client.ts, docs/purchases.md). A Test Store key starts
# with test_ and simulates every purchase; a Web Billing sandbox key starts
# with rcb_sb_, a production key with rcb_. Absent, the Ada Pro pane says
# purchases are not configured and the order step is never locked by the app.
# A production build refuses a test_ key unless ADA_ALLOW_TEST_STORE=1 is set
# in the build's environment (vite.config.ts).
VITE_REVENUECAT_PUBLIC_KEY=
